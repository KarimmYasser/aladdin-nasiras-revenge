{
    "start-scene": "play",
    "window":
    {
        "title":"Aladdin Enemy AI Test",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "clearColor": [0.1, 0.1, 0.1, 1],
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                }
            },
            "textures":{
                "grass": "assets/textures/grass_ground_d.jpg"
            },
            "meshes":{
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj"
            },
            "samplers":{
                "default":{}
            },
            "materials":{
                "aladdin_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [1, 0.5, 0, 1]
                },
                "guard_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [0.5, 0, 0, 1]
                },
                "floor_mat":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass",
                    "sampler": "default"
                }
            }
        },
        "world":[
            {
                "name": "Camera",
                "components": [
                    {
                        "type": "Camera",
                        "cameraType": "perspective",
                        "near": 0.1,
                        "far": 1000,
                        "fovY": 45
                    }
                ],
                "position": [0, 5, 10],
                "rotation": [-0.3, 0, 0]
            },
            {
                "name": "Floor",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "plane",
                        "material": "floor_mat"
                    }
                ],
                "position": [0, 0, 0],
                "scale": [100, 1, 100]
            },
            {
                "name": "Aladdin",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "aladdin_mat"
                    },
                    {
                        "type": "Aladdin Controller",
                        "speed": 8.0,
                        "jumpForce": 12.0,
                        "enableCameraFollow": true,
                        "cameraOffset": [0, 5, 10],
                        "cameraSmoothing": 5.0,
                        "health": 100,
                        "lives": 3,
                        "respawnPosition": [0, 0, 0]
                    }
                ],
                "position": [0, 0, 0]
            },
            {
                "name": "Palace Guard 1",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "guard_mat"
                    },
                    {
                        "type": "Enemy",
                        "patrolSpeed": 2.0,
                        "chaseSpeed": 4.0,
                        "detectionRange": 10.0,
                        "attackRange": 1.5,
                        "health": 50,
                        "damage": 10,
                        "waypoints": [
                            [-5, 0, -6],
                            [5, 0, -6]
                        ]
                    }
                ],
                "position": [0, 0, 0]
            },
            {
                "name": "Palace Guard 2",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "guard_mat"
                    },
                    {
                        "type": "Enemy",
                        "patrolSpeed": 3.0,
                        "chaseSpeed": 5.0,
                        "detectionRange": 3.0,
                        "attackRange": 1.5,
                        "health": 75,
                        "damage": 20,
                        "waypoints": [
                            [-8, 0, -12],
                            [8, 0, -12]
                        ]
                    }
                ],
                "position": [-8, 0, -12]
            }
        ]
    }
}
