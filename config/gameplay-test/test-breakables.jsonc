{
    "start-scene": "play",
    "window":
    {
        "title":"Aladdin Breakable Props Test",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "clearColor": [0.1, 0.1, 0.1, 1],
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                }
            },
            "textures":{
                "grass": "assets/textures/grass_ground_d.jpg"
            },
            "meshes":{
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj"
            },
            "samplers":{
                "default":{}
            },
            "materials":{
                "aladdin_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [1, 0.5, 0, 1]
                },
                "pot_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [0.6, 0.3, 0.1, 1]
                },
                "loot_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [1, 1, 0, 1]
                },
                "floor_mat":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{"enabled": false},
                        "depthTesting": {"enabled": true}
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass",
                    "sampler": "default"
                }
            }
        },
        "world":[
            {
                "name": "Camera",
                "components": [
                    {
                        "type": "Camera",
                        "cameraType": "perspective",
                        "near": 0.1,
                        "far": 1000,
                        "fovY": 45
                    }
                ],
                "position": [0, 5, 10],
                "rotation": [-0.3, 0, 0]
            },
            {
                "name": "Floor",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "plane",
                        "material": "floor_mat"
                    }
                ],
                "position": [0, 0, 0],
                "scale": [100, 1, 100]
            },
            {
                "name": "Aladdin",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "aladdin_mat"
                    },
                    {
                        "type": "Aladdin Controller",
                        "speed": 8.0,
                        "jumpForce": 12.0,
                        "enableCameraFollow": true,
                        "cameraOffset": [0, 5, 10],
                        "cameraSmoothing": 5.0,
                        "health": 100,
                        "lives": 3,
                        "respawnPosition": [0, 0, 0]
                    }
                ],
                "position": [0, 0, 0]
            },
            {
                "name": "Clay Pot 1 (Multi Loot)",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "pot_mat"
                    },
                    {
                        "type": "Breakable",
                        "loot": [
                            { "type": "coin", "value": 50 },
                            { "type": "gem", "value": 1 },
                            { "type": "apple", "value": 3 }
                        ]
                    }
                ],
                "position": [-3, 0, -5],
                "scale": [1, 1.5, 1]
            },
            {
                "name": "Clay Pot 2 (Gem)",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "pot_mat"
                    },
                    {
                        "type": "Breakable",
                        "lootType": "gem",
                        "lootValue": 1
                    }
                ],
                "position": [3, 0, -5],
                "scale": [1, 1.5, 1]
            },
            {
                "name": "Clay Pot 3 (Apple)",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "pot_mat"
                    },
                    {
                        "type": "Breakable",
                        "lootType": "apple",
                        "lootValue": 5
                    }
                ],
                "position": [0, 0, -10],
                "scale": [1, 1.5, 1]
            }
        ]
    }
}
