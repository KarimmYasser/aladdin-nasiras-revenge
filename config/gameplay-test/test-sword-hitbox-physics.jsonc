{
    "start-scene": "play",
    "window": {
        "title": "Sword Hitbox Physics Test",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "clearColor": [0.09, 0.09, 0.12, 1.0],
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "grass": "assets/textures/grass_ground_d.jpg"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj"
            },
            "samplers": {
                "default": {}
            },
            "materials": {
                "aladdin_mat": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": { "depthTesting": { "enabled": true } },
                    "tint": [1, 0.5, 0, 1]
                },
                "enemy_mat": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": { "depthTesting": { "enabled": true } },
                    "tint": [0.7, 0.15, 0.15, 1]
                },
                "target_mat": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": { "depthTesting": { "enabled": true } },
                    "tint": [1, 0.0, 0.0, 1]
                },
                "floor_mat": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": { "depthTesting": { "enabled": true } },
                    "texture": "grass",
                    "sampler": "default"
                }
            }
        },
        "world": [
            {
                "name": "Camera",
                "components": [
                    { "type": "Camera", "cameraType": "perspective", "near": 0.1, "far": 1000, "fovY": 45 }
                ],
                "position": [0, 7, 14],
                "rotation": [-0.35, 0, 0]
            },
            {
                "name": "Floor",
                "components": [
                    { "type": "Mesh Renderer", "mesh": "plane", "material": "floor_mat" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [30, 0.5, 30], "friction": 0.8, "restitution": 0.0 }
                ],
                "position": [0, -0.5, 0],
                "scale": [60, 1, 60]
            },
            {
                "name": "Aladdin",
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "aladdin_mat" },
                    { "type": "Aladdin Controller", "speed": 8.0, "jumpForce": 9.0, "enableCameraFollow": true, "cameraOffset": [0, 5, 10], "cameraSmoothing": 4.0 },
                    { "type": "RigidBody", "bodyType": "dynamic", "mass": 1.0, "useGravity": true, "lockRotation": true },
                    { "type": "Collider", "shape": "box", "halfExtents": [0.45, 0.9, 0.45], "friction": 0.6, "restitution": 0.0 }
                ],
                "position": [0, 2, 0],
                "scale": [1, 2, 1]
            },
            {
                "name": "Target 1",
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "target_mat" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [0.5, 0.5, 0.5], "isTrigger": true }
                ],
                "position": [2.2, 1.0, 0],
                "scale": [1, 1, 1]
            },
            {
                "name": "Palace Guard Hitbox Test",
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "enemy_mat" },
                    { "type": "Enemy", "patrolSpeed": 0.0, "chaseSpeed": 0.0, "detectionRange": 20.0, "attackRange": 1.2, "health": 75, "damage": 10, "waypoints": [[3.0, 0.0, 2.0]] },
                    { "type": "RigidBody", "bodyType": "dynamic", "mass": 1.0, "useGravity": true, "lockRotation": true },
                    { "type": "Collider", "shape": "box", "halfExtents": [0.45, 0.9, 0.45], "friction": 0.6, "restitution": 0.0 }
                ],
                "position": [2.2, 2.0, 2.0],
                "scale": [1, 2, 1]
            }
        ]
    }
}
