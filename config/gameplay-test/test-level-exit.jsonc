{
    "start-scene": "play",
    "window":
    {
        "title":"Aladdin Level Exit Test",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "clearColor": [0.1, 0.1, 0.1, 1],
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                }
            },
            "textures":{
                "grass": "assets/textures/grass_ground_d.jpg"
            },
            "meshes":{
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj"
            },
            "samplers":{
                "default":{}
            },
            "materials":{
                "aladdin_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {"depthTesting": {"enabled": true}},
                    "tint": [1, 1, 1, 1]
                },
                "floor_mat":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {"depthTesting": {"enabled": true}},
                    "texture": "grass",
                    "sampler": "default"
                },
                "key_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {"depthTesting": {"enabled": true}},
                    "tint": [1, 0.8, 0, 1]
                },
                "exit_mat":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {"depthTesting": {"enabled": true}},
                    "tint": [0.5, 0, 0.5, 1]
                }
            }
        },
        "world":[
            {
                "name": "Camera",
                "components": [
                    {
                        "type": "Camera",
                        "cameraType": "perspective",
                        "near": 0.1,
                        "far": 1000,
                        "fovY": 45
                    }
                ],
                "position": [0, 5, 15],
                "rotation": [-0.3, 0, 0]
            },
            {
                "name": "Floor",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "plane",
                        "material": "floor_mat"
                    },
                    {
                        "type": "RigidBody",
                        "bodyType": "static",
                        "mass": 0,
                        "useGravity": false
                    },
                    {
                        "type": "Collider",
                        "shape": "box",
                        "halfExtents": [50, 0.5, 50],
                        "friction": 0.8,
                        "restitution": 0.0
                    }
                ],
                "position": [0, -0.5, 0],
                "scale": [100, 1, 100]
            },
            {
                "name": "Aladdin",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "aladdin_mat"
                    },
                    {
                        "type": "Aladdin Controller",
                        "speed": 10.0,
                        "jumpForce": 15.0,
                        "enableCameraFollow": true,
                        "cameraOffset": [0, 5, 15],
                        "cameraSmoothing": 5.0
                    },
                    {
                        "type": "RigidBody",
                        "bodyType": "dynamic",
                        "mass": 1.0,
                        "useGravity": true,
                        "lockRotation": true
                    },
                    {
                        "type": "Collider",
                        "shape": "box",
                        "halfExtents": [0.45, 0.9, 0.45],
                        "friction": 0.6,
                        "restitution": 0.0
                    }
                ],
                "position": [0, 2, 0],
                "scale": [1, 2, 1]
            },
            {
                "name": "Golden Key",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "key_mat"
                    },
                    {
                        "type": "Collectible",
                        "collectibleType": "key",
                        "rotationSpeed": 3.0,
                        "bobbingHeight": 0.3
                    },
                    {
                        "type": "RigidBody",
                        "bodyType": "static",
                        "mass": 0,
                        "useGravity": false
                    },
                    {
                        "type": "Collider",
                        "shape": "sphere",
                        "radius": 0.5,
                        "isTrigger": true
                    }
                ],
                "position": [10, 1, 0],
                "scale": [0.5, 0.5, 0.5]
            },
            {
                "name": "Level Exit Door",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "exit_mat"
                    },
                    {
                        "type": "LevelExit",
                        "nextScene": "config/gameplay-test/test-aladdin.jsonc",
                        "radius": 3.0
                    },
                    {
                        "type": "RigidBody",
                        "bodyType": "static",
                        "mass": 0,
                        "useGravity": false
                    },
                    {
                        "type": "Collider",
                        "shape": "box",
                        "halfExtents": [2, 3, 1],
                        "isTrigger": true
                    }
                ],
                "position": [0, 1.5, -10],
                "scale": [2, 3, 1]
            }
        ]
    }
}
