{
    "start-scene": "play",
    "window": { "title": "Physics Test 3: Friction", "size": { "width": 1280, "height": 720 }, "fullscreen": false },
    "scene": {
        "renderer": { "sky": "assets/textures/sky.jpg" },
        "assets": {
            "shaders": { "tinted": { "vs": "assets/shaders/tinted.vert", "fs": "assets/shaders/tinted.frag" } },
            "materials": {
                "groundMat": { "type": "tinted", "shader": "tinted", "pipelineState": { "faceCulling":{ "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.2, 0.5, 0.2, 1.0] },
                "redMat": { "type": "tinted", "shader": "tinted", "pipelineState": { "faceCulling":{ "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [1.0, 0.2, 0.2, 1.0] },
                "greenMat": { "type": "tinted", "shader": "tinted", "pipelineState": { "faceCulling":{ "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.2, 1.0, 0.2, 1.0] }
            },
            "meshes": { "plane": "assets/models/plane.obj", "cube": "assets/models/cube.obj" }
        },
        "world": [
            { "name": "Camera", "position": [0, 8, 25], "rotation": [-15, 0, 0], "components": [ { "type": "Camera", "cameraType": "perspective", "fovY": 90.0, "near": 0.1, "far": 100.0 }, { "type": "Free Camera Controller" } ] },
            { "name": "Angled Ramp", "position": [0, -2, -5], "rotation": [15, 0, 0], "scale": [20, 1, 20], "components": [ { "type": "Mesh Renderer", "mesh": "plane", "material": "groundMat" }, { "type": "RigidBody", "bodyType": "static", "mass": 0 }, { "type": "Collider", "shape": "box", "halfExtents": [20, 1, 20], "friction": 0.5 } ] },
            { "name": "Ice Cube (0.0 Friction)", "position": [-5, 8, -10], "rotation": [15, 0, 0], "components": [ { "type": "Mesh Renderer", "mesh": "cube", "material": "redMat" }, { "type": "RigidBody", "bodyType": "dynamic", "mass": 1.0, "useGravity": true }, { "type": "Collider", "shape": "box", "halfExtents": [0.5, 0.5, 0.5], "friction": 0.0 } ] },
            { "name": "Rubber Cube (0.9 Friction)", "position": [5, 8, -10], "rotation": [15, 0, 0], "components": [ { "type": "Mesh Renderer", "mesh": "cube", "material": "greenMat" }, { "type": "RigidBody", "bodyType": "dynamic", "mass": 1.0, "useGravity": true }, { "type": "Collider", "shape": "box", "halfExtents": [0.5, 0.5, 0.5], "friction": 0.9 } ] }
        ]
    }
}

