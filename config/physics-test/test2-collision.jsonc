{
    "start-scene": "play",
    "window": {
        "title": "Physics Test 2: Collisions & Velocity",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": false
    },
    "scene": {
        "renderer": { "sky": "assets/textures/sky.jpg" },
        "assets": {
            "shaders": {
                "tinted": { "vs": "assets/shaders/tinted.vert", "fs": "assets/shaders/tinted.frag" }
            },
            "materials": {
                "groundMat": { "type": "tinted", "shader": "tinted", "pipelineState": { "faceCulling":{ "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.2, 0.5, 0.2, 1.0] },
                "movingMat": { "type": "tinted", "shader": "tinted", "pipelineState": { "faceCulling":{ "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.8, 0.8, 0.2, 1.0] },
                "targetMat": { "type": "tinted", "shader": "tinted", "pipelineState": { "faceCulling":{ "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.2, 0.8, 0.8, 1.0] }
            },
            "meshes": {
                "plane": "assets/models/plane.obj",
                "cube": "assets/models/cube.obj"
            }
        },
        "world": [
            {
                "name": "Camera",
                "position": [0, 10, 20],
                "rotation": [-30, 0, 0],
                "scale": [1, 1, 1],
                "components": [
                    { "type": "Camera", "cameraType": "perspective", "fovY": 90.0, "near": 0.1, "far": 100.0 },
                    { "type": "Free Camera Controller" }
                ]
            },
            {
                "name": "Ground",
                "position": [0, -5, 0],
                "rotation": [0, 0, 0],
                "scale": [30, 1, 30],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "plane", "material": "groundMat" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0.0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [30, 1, 30], "friction": 0.1, "restitution": 0.2 }
                ]
            },
            {
                "name": "Moving Cube",
                "position": [-15, -4, 0],
                "rotation": [0, 0, 0],
                "scale": [1, 1, 1],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "movingMat" },
                    { "type": "RigidBody", "bodyType": "dynamic", "mass": 2.0, "useGravity": true, "velocity": [20, 0, 0] },
                    { "type": "Collider", "shape": "box", "halfExtents": [0.5, 0.5, 0.5], "friction": 0.1, "restitution": 0.5 }
                ]
            },
            {
                "name": "Target Cube 1",
                "position": [5, -4, 0],
                "rotation": [0, 45, 0],
                "scale": [1, 1, 1],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "targetMat" },
                    { "type": "RigidBody", "bodyType": "dynamic", "mass": 1.0, "useGravity": true, "velocity": [0, 0, 0] },
                    { "type": "Collider", "shape": "box", "halfExtents": [0.5, 0.5, 0.5], "friction": 0.5, "restitution": 0.5 }
                ]
            }
        ]
    }
}

