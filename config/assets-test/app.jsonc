// Asset showcase: Agrabah-style ground/walls, desert sky, door texture, gameplay props.
// Enemy OBJs use ~100+ model units; this scene uses scale ~0.017 (level01 uses ~0.5 in a huge world).
// Run from project root: bin\GAME_APPLICATION.exe -c config/assets-test/app.jsonc
// Free camera: hold LMB to look; WASD move; Q/E up-down; Shift sprint; wheel FOV. ESC closes window.
{
    "start-scene": "renderer-test",
    "window": {
        "title": "Aladdin — Asset test (props, walls, door, sky)",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky_desert.png"
        },
        "assets": {
            "shaders": {
                "light": {
                    "vs": "assets/shaders/light.vert",
                    "fs": "assets/shaders/light.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "agrabah_ground": "assets/textures/agrabah_ground.png",
