                "jasmine_tex": "assets/models/Jasmine/jasmine_diff.png",
                "aladdin_skin": "assets/models/Aladdin/aladdin_diff.png"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj",
                "aladdin_mesh": "assets/models/Aladdin/aladdin_costume_basic.obj",
                "coin_mesh": "assets/models/Coin/Coin.obj",
                "apple_mesh": "assets/models/Apple/apple.obj",
                "enemy1_mesh": "assets/models/Enemies/Enemy 1/BigTrashEnemy2.obj",
                "enemy2_mesh": "assets/models/Enemies/Enemy 2/SlimeEnemy1.obj",
                "enemy3_mesh": "assets/models/Enemies/Enemy 3/TrashEnemy1.obj",
                "pot_mesh": "assets/models/Pots/Pot1/PotLight.obj",
                "sword_mesh": "assets/models/Swords/Aladdin Sword/Magician Sword.obj"
            },
            "samplers": {
                "default": {},
                "repeat": {
                    "WRAP_S": "GL_REPEAT",
                    "WRAP_T": "GL_REPEAT"
                }
            },
            "materials": {
                "lit-ground": {
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "albedo_map": "agrabah_ground",
                    "sampler": "repeat",
                    "shininess": 10.0,
                    "ambient": 0.32,
                    "uv_multiplier": [24, 24]
