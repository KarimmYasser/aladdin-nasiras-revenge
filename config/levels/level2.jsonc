{
    // =====================================================================
    //  Aladdin — Level 2 (4 Places complete)
    //
    //  All buildings use the EXACT scales and collider halfExtents from
    //  config/assets-test/app.jsonc (team-agreed sizes). Every building
    //  now has a solid collider so you cannot walk through it.
    //
    //  ┌──────────── PLACE 1 (Agrabah square) ──────────┐
    //  │  Area 1  : 120×120 interior (x ∈ [-60, 60])    │
    //  │  Corridor: length 100 (x ∈ [60, 160], z ±8)    │
    //  │  Area 2  : 160×160 (center x=240) — 3 enemies  │
    //  │  Portal (x≈308) → PLACE 2 entry [435, 2, 0]    │
    //  └────────────────────────────────────────────────┘
    //
    //  ┌──────────── PLACE 2 (First Genie meeting) ─────┐
    //  │  60×60 open arena, hidden safety walls         │
    //  │  Center (460, 0, 0). No enemies, just magic.   │
    //  │  Lamp at (460, 0.45, 0) + Genie at (463, 0,-4) │
    //  │  Portal (x≈486) → PLACE 3 entry [595, 2, 0]    │
    //  │  Dialogue: config/levels/dialogues/meeting-1.json │
    //  └────────────────────────────────────────────────┘
    //
    //  ┌──────────── PLACE 3 (Second meeting + slimes) ─┐
    //  │  60×60 open arena, hidden safety walls         │
    //  │  Center (620, 0, 0). 3 slime enemies.          │
    //  │  Lamp at (605, 0.45, 0) — meeting near spawn   │
    //  │  Portal (x≈646) → PLACE 4 arena                │
    //  │  Dialogue: config/levels/dialogues/meeting-2.json │
    //  └────────────────────────────────────────────────┘
    // =====================================================================

    "start-scene": "menu",
    "window": {
        "title": "Aladdin — Level 2",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": true
    },
    "game": {
        "total_coins": 14,
        "total_enemies": 11,
        "time_3star": 420,
        "time_2star": 540,
        "time_1star": 720
    },

    "scene": {
        "renderer": {
            "sky": "assets/textures/sky_desert.png",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },

        "assets": {
            "shaders": {
                "tinted":   { "vs": "assets/shaders/tinted.vert",   "fs": "assets/shaders/tinted.frag"   },
                "textured": { "vs": "assets/shaders/textured.vert", "fs": "assets/shaders/textured.frag" },
                "light":    { "vs": "assets/shaders/light.vert",    "fs": "assets/shaders/light.frag"    },
                "skinned":  { "vs": "assets/shaders/skinned.vert", "fs": "assets/shaders/light.frag"    }
            },
            "textures": {
                "agrabah_ground": "assets/textures/agrabah_ground.png",
                "agrabah_wall":   "assets/textures/agrabah_wall.png",
                "temple_wall":    "assets/models/Walls/stylized_temple_wall/lambert1_baseColor.png",

                // Buildings
                "tex_desert_house_brick": "assets/models/Environment objects/Buildings/desert_house/Brick1_baseColor.jpg",
                "tex_desert_shop_main":   "assets/models/Environment objects/Buildings/desert_shop/HouseMain_baseColor.jpg",
                "tex_poor_house":         "assets/models/Environment objects/Buildings/poor_desert_house/House_Lil_baseColor.png",
                "tex_kasbah":             "assets/models/Environment objects/Buildings/stylized_kasbah/Material_001_baseColor.png",
                "tex_agraba_shop":        "assets/models/Environment objects/agraba_market_shop/material_baseColor.jpg",

                // Fountains
                "tex_fountain1": "assets/models/Environment objects/Fountains/Fountain 1/fou_01.png",
                "tex_fountain2": "assets/models/Environment objects/Fountains/Fountain 2/Material__0.png",

                // Aladdin
                "aladdin_skin": "assets/models/Aladdin/aladdin_diff.png",

                // Collectibles / decor
                "coin_tex":  "assets/models/Coin/Item_Coin_Texture.png",
                "apple_tex": "assets/models/Apple/Handle1Tex.png",

                // Pots
                "pot_tex":         "assets/models/Pots/Pot1/PotLight.0.png",
                "pot_small_tex":   "assets/models/Pots/Pot 2/Txm_tsubo02.png",
                "pot_aotubo_tex":  "assets/models/Pots/Pot 3/D_aotubo00.png",

                // Enemies
                "enemy1_tex": "assets/models/Enemies/Enemy 1/000000002EF475B8.png",
                "enemy2_tex": "assets/models/Enemies/Enemy 2/000000002EE61638.png",
                "enemy3_tex": "assets/models/Enemies/Enemy 3/000000002E4ECFB8.png",

                // Portal / carpet
                "portal_tex_0": "assets/models/Portal/0.png",
                "portal_tex_1": "assets/models/Portal/1.png",
                "carpet_tex":   "assets/models/Carpet/magic_carpet_diff.png",

                // Genie (NPC for meetings in Place 2 & 3)
                "genie_tex":   "assets/models/Genie/genie_diff.png",
                "key_tex":     "assets/models/Key/KeySwitch.png"
            },
            "meshes": {
                "cube":   "assets/models/cube.obj",
                "plane":  "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj",

                "aladdin_mesh": "assets/models/Aladdin/aladdin_costume_basic.obj",

                "coin_mesh":       "assets/models/Coin/Coin.obj",
                "apple_mesh":      "assets/models/Apple/apple.obj",
                "pot_mesh":        "assets/models/Pots/Pot1/PotLight.obj",
                "pot_small_mesh":  "assets/models/Pots/Pot 2/pot_small.obj",
                "pot_aotubo_mesh": "assets/models/Pots/Pot 3/aotubo.obj",

                "enemy1_mesh": "assets/models/Enemies/Enemy 1/BigTrashEnemy2.obj",
                "enemy2_mesh": "assets/models/Enemies/Enemy 2/SlimeEnemy1.obj",
                "enemy3_mesh": "assets/models/Enemies/Enemy 3/TrashEnemy1.obj",

                "portal_highelf": "assets/models/Portal/highelfportal.obj",

                "env_desert_house":       "assets/models/Environment objects/Buildings/desert_house/desert_house.obj",
                "env_desert_shop":        "assets/models/Environment objects/Buildings/desert_shop/desert_shop.obj",
                "env_poor_desert_house":  "assets/models/Environment objects/Buildings/poor_desert_house/poor_desert_house.obj",
                "env_stylized_kasbah":    "assets/models/Environment objects/Buildings/stylized_kasbah/stylized_kasbah__tier_i.obj",
                "env_agraba_market_shop": "assets/models/Environment objects/agraba_market_shop/agraba_market_shop.obj",

                "env_fountain_1": "assets/models/Environment objects/Fountains/Fountain 1/Fountain.obj",
                "env_fountain_2": "assets/models/Environment objects/Fountains/Fountain 2/Fountain.obj",

                // Magic lamp (appears in Place 2 & 3 for Genie meetings)
                "env_aladdin_lamp": "assets/models/Environment objects/aladdin_lamp/aladdin_lamp.obj",

                // Genie (NPC — appears near the lamp, disappears after dialogue)
                "genie_mesh": "assets/models/Genie/genie.obj",
                "key_mesh": "assets/models/Key/model.obj"
            },
            "samplers": {
                "default": {},
                "repeat":  { "WRAP_S": "GL_REPEAT", "WRAP_T": "GL_REPEAT" }
            },
            "materials": {
                "lit-ground": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "agrabah_ground", "sampler": "repeat",
                    "shininess": 12.0, "ambient": 0.3,
                    "uv_multiplier": [60, 24]
                },
                "lit-wall": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "agrabah_wall", "sampler": "repeat",
                    "shininess": 18.0, "ambient": 0.26,
                    "uv_multiplier": [10, 2]
                },
                "lit-temple-wall": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "temple_wall", "sampler": "repeat",
                    "shininess": 28.0, "ambient": 0.3,
                    "uv_multiplier": [14, 2]
                },

                // Buildings (identical to assets-test)
                "lit-env-desert-house": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_desert_house_brick", "sampler": "default",
                    "shininess": 22.0, "ambient": 0.32
                },
                "lit-env-desert-shop": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_desert_shop_main", "sampler": "default",
                    "shininess": 24.0, "ambient": 0.32
                },
                "lit-env-poor-house": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_poor_house", "sampler": "default",
                    "shininess": 20.0, "ambient": 0.32
                },
                "lit-env-kasbah": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_kasbah", "sampler": "default",
                    "shininess": 26.0, "ambient": 0.3
                },
                "lit-env-agraba-shop": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_agraba_shop", "sampler": "default",
                    "shininess": 22.0, "ambient": 0.32
                },

                // Fountains
                "lit-env-fountain1": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_fountain1", "sampler": "default",
                    "shininess": 48.0, "ambient": 0.34
                },
                "lit-env-fountain2": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "tex_fountain2", "sampler": "default",
                    "shininess": 40.0, "ambient": 0.32
                },

                // Hero (skinned FBX — same material setup as level1.jsonc)
                "lit-aladdin": {
                    "type": "lit",
                    "shader": "skinned",
                    "albedo_map": "aladdin_skin",
                    "sampler": "default",
                    "shininess": 10.0,
                    "ambient": 0.26,
                    "albedo_tint": [1, 1, 1],
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    }
                },

                // Pickups
                "coin-mat": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "coin_tex", "sampler": "default",
                    "shininess": 16.0, "ambient": 0.35
                },
                "lit-apple": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "apple_tex", "sampler": "default",
                    "shininess": 48.0, "ambient": 0.32
                },
                "lit-key": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "key_tex", "sampler": "default",
                    "shininess": 48.0, "ambient": 0.30
                },

                // Pots
                "lit-pot": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "pot_tex", "sampler": "default",
                    "shininess": 28.0, "ambient": 0.32
                },
                "lit-pot-small": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "pot_small_tex", "sampler": "default",
                    "shininess": 28.0, "ambient": 0.32
                },
                "lit-pot-aotubo": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": true }, "depthTesting": { "enabled": true } },
                    "albedo_map": "pot_aotubo_tex", "sampler": "default",
                    "shininess": 30.0, "ambient": 0.32
                },

                // Enemies
                "lit-enemy1": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "enemy1_tex", "sampler": "default",
                    "shininess": 20.0, "ambient": 0.32
                },
                "lit-enemy2": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "enemy2_tex", "sampler": "default",
                    "shininess": 36.0, "ambient": 0.32
                },
                "lit-enemy3": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "enemy3_tex", "sampler": "default",
                    "shininess": 18.0, "ambient": 0.32
                },

                // Portal
                "lit-portal-0": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "portal_tex_0", "sampler": "default",
                    "shininess": 40.0, "ambient": 0.35
                },
                "lit-portal-1": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "portal_tex_1", "sampler": "default",
                    "shininess": 40.0, "ambient": 0.35
                },

                // Carpet (spawn decoration)
                "lit-carpet": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "carpet_tex", "sampler": "default",
                    "shininess": 18.0, "ambient": 0.36,
                    "uv_multiplier": [1.2, 1.2]
                },

                // Magic lamp — ACTIVE (glowing gold) — triggers Genie meeting
                "lit-env-lamp": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "sampler": "default",
                    "shininess": 82.0, "ambient": 0.42,
                    "albedo_tint": [1.0, 0.82, 0.32]
                },
                // Magic lamp — USED (dim, spent) — remains after Genie disappears
                "lit-env-lamp-used": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "sampler": "default",
                    "shininess": 10.0, "ambient": 0.22,
                    "albedo_tint": [0.45, 0.38, 0.22]
                },

                // Genie NPC
                "lit-genie": {
                    "type": "lit", "shader": "light",
                    "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
                    "albedo_map": "genie_tex", "sampler": "default",
                    "shininess": 24.0, "ambient": 0.36,
                    "albedo_tint": [0.72, 0.92, 1.0]
                }
            }
        },

        "world": [
            // ============================================================
            //  Camera & Lights
            // ============================================================
            {
                "name": "Camera",
                "position": [-45, 16, 24],
                "rotation": [-28, 0, 0],
                "components": [
                    { "type": "Camera", "cameraType": "perspective", "near": 0.1, "far": 1100, "fovY": 58 }
                ]
            },
            {
                "name": "sun",
                "rotation": [-44, -118, 0],
                "components": [
                    { "type": "Light", "light_type": "directional", "color": [1.0, 0.95, 0.82], "intensity": 1.55 }
                ]
            },
            {
                "name": "fill-area1",
                "position": [0, 16, 0],
                "components": [
                    { "type": "Light", "light_type": "point",
                      "color": [1.0, 0.9, 0.78], "intensity": 3.4,
                      "attenuation": { "constant": 1.0, "linear": 0.04, "quadratic": 0.01 } }
                ]
            },
            {
                "name": "fill-corridor",
                "position": [110, 10, 0],
                "components": [
                    { "type": "Light", "light_type": "point",
                      "color": [1.0, 0.88, 0.72], "intensity": 2.5,
                      "attenuation": { "constant": 1.0, "linear": 0.06, "quadratic": 0.018 } }
                ]
            },
            {
                "name": "fill-area2",
                "position": [240, 16, 0],
                "components": [
                    { "type": "Light", "light_type": "point",
                      "color": [1.0, 0.86, 0.72], "intensity": 3.6,
                      "attenuation": { "constant": 1.0, "linear": 0.04, "quadratic": 0.01 } }
                ]
            },

            // ============================================================
            //  GROUND — covers everything (x ∈ [-80, 340], z ∈ [-100, 100])
            // ============================================================
            {
                "name": "place1-ground",
                "position": [130, 0, 0],
                "rotation": [-90, 0, 0],
                "scale": [420, 200, 1],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "plane", "material": "lit-ground" }
                ]
            },
            {
                "name": "place1-floor-collider",
                "position": [130, -0.25, 0],
                "components": [
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [210, 0.3, 100], "friction": 0.85, "restitution": 0.0 }
                ]
            },

            // ============================================================
            //  AREA 1 — Invisible safety perimeter (physics only)
            //    Interior walkable: x ∈ [-79, 79], z ∈ [-79, 79].
            //    Corridor gap: z ∈ [-8, 8] at x = 80.
            // ============================================================
            { "name": "a1-bound-n",   "position": [0, 8, -80],
                "components": [
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [80, 8, 1], "friction": 0.8 }
                ] },
            { "name": "a1-bound-s",   "position": [0, 8, 80],
                "components": [
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [80, 8, 1], "friction": 0.8 }
                ] },
            { "name": "a1-bound-w",   "position": [-80, 8, 0],
                "components": [
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [1, 8, 80], "friction": 0.8 }
                ] },
            // East side split around the corridor mouth (gap: z ∈ [-8, 8]).
            // Area 1 half-extent = 80, corridor half-gap = 8  →  each piece spans 72,
            // so half-extent in z = 36 and center z = (80+8)/2 = 44.
            { "name": "a1-bound-e-n", "position": [80, 8, -44],
                "components": [
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [1, 8, 36], "friction": 0.8 }
                ] },
            { "name": "a1-bound-e-s", "position": [80, 8, 44],
                "components": [
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [1, 8, 36], "friction": 0.8 }
                ] },

            // ============================================================
            //  AREA 1 — Buildings (test-app scales + colliders)
            //
            //  Layout per request:
            //    NORTH ring : 4 × poor_desert_house (scale 6.0)
            //    SOUTH ring : 4 × poor_desert_house
            //    WEST  ring : 3 × poor_desert_house
            //    EAST (outside corridor flanks): 2 × poor_desert_house
            //    Inside, framing corridor mouth: 2 × agraba_market_shop
            //    Sprinkled interior decoration : 2 × desert_house
            //
            //  poor_desert_house : scale 6.0,  halfExtents [14.5, 26, 18.5]
            //  desert_house      : scale 1.6,  2 hit boxes (pivot-offset mesh)
            //  agraba_market_shop: scale 2.3,  halfExtents [8.5, 6.5, 8.5]
            // ============================================================

            // ----- NORTH ring (z = -82, rotation 180° facing south) -----
            { "name": "a1-n-poor-1", "position": [-45, 0, -82], "rotation": [0, 0, 0], "scale": [6.0, 6.0, 6.0],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "env_poor_desert_house", "material": "lit-env-poor-house" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [14.5, 26, 18.5], "friction": 0.55 }
                ] },
            { "name": "a1-n-poor-2", "position": [-15, 0, -82], "rotation": [0, 0, 0], "scale": [6.0, 6.0, 6.0],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "env_poor_desert_house", "material": "lit-env-poor-house" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [14.5, 26, 18.5], "friction": 0.55 }
                ] },
            { "name": "a1-n-poor-3", "position": [15, 0, -82], "rotation": [0, 0, 0], "scale": [6.0, 6.0, 6.0],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "env_poor_desert_house", "material": "lit-env-poor-house" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [14.5, 26, 18.5], "friction": 0.55 }
                ] },
            { "name": "a1-n-poor-4", "position": [45, 0, -82], "rotation": [0, 0, 0], "scale": [6.0, 6.0, 6.0],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "env_poor_desert_house", "material": "lit-env-poor-house" },
                    { "type": "RigidBody", "bodyType": "static", "mass": 0, "useGravity": false },
                    { "type": "Collider", "shape": "box", "halfExtents": [14.5, 26, 18.5], "friction": 0.55 }
                ] },

            // ----- SOUTH ring (z = +82, rotation 0°) -----
