{
    // Level 3 — Two-map flow:
    //   Map 1: Desert Town
    //   Map 2: Desert fort (ancient_desert_fort)
    // Portal teleports Map 1 -> Map 2; LevelExit in Map 2.
    //
    // Meshes use large model units; uniform scale ~0.0025. Tune transform / spawn / portal with M debug.
    // "submeshMaterials" maps tinyobj MTL names to scene lit materials.
    // Desert_Town ground.001 uses tilted normals (~34° from +Y in +Z) — pitch corrects it to horizontal XZ.

    "start-scene": "play",
    "window": {
        "title": "Aladdin — Level 3 (Desert Town -> Desert Fort)",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": false
    },
    "game": {
        "total_coins": 10,
        "total_enemies": 6,
        "time_3star": 300,
        "time_2star": 420,
        "time_1star": 600,
        "game_over_fall_y": -55
    },

    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": { "vs": "assets/shaders/tinted.vert", "fs": "assets/shaders/tinted.frag" },
                "textured": { "vs": "assets/shaders/textured.vert", "fs": "assets/shaders/textured.frag" },
                "light": { "vs": "assets/shaders/light.vert", "fs": "assets/shaders/light.frag" },
