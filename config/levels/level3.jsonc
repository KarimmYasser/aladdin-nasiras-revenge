{
    // Level 3 — Two-map flow:
    //   Map 1: Pembroke castle
    //   Map 2: Raby castle
    // Portal teleports from Map 1 -> Map 2, then a final LevelExit in Map 2.
    //
    // Mesh: assets/models/Maps/pembroke_castle/pembroke_castle.obj (large; first load parses once).
    // "submeshMaterials" maps tinyobj MTL names (mat0, mat1, …) to scene materials.
    // Collider shape "concaveMesh" + "mesh" (same asset name) builds a static triangle mesh
    // in ReactPhysics3D — walk on real geometry (no flat floor box).
    //
    // Orientation: pitch 180° + scale — tune entity transform if your export differs.

    "start-scene": "play",
    "window": {
        "title": "Aladdin — Level 3 (Pembroke -> Raby)",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": false
    },
    "game": {
        "total_coins": 10,
        "total_enemies": 6,
        "time_3star": 300,
        "time_2star": 420,
        "time_1star": 600
    },

    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": { "vs": "assets/shaders/tinted.vert", "fs": "assets/shaders/tinted.frag" },
                "textured": { "vs": "assets/shaders/textured.vert", "fs": "assets/shaders/textured.frag" },
                "light": { "vs": "assets/shaders/light.vert", "fs": "assets/shaders/light.frag" },
                "skinned": { "vs": "assets/shaders/skinned.vert", "fs": "assets/shaders/light.frag" }
            },
            "textures": {
