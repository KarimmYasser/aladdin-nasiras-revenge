{
    // Level 3 — Three-area flow:
    //   Map 1: Desert Town
    //   Map 2: Desert fort (ancient_desert_fort)
    //   Map 3: Ancient Desert Arena
    // Portal: Map 1 -> Map 2; Map 2 -> Map 3; LevelExit (victory) on Map 3.
    //
    // Fort mesh scale ~0.0075 (3x older 0.0025) + pitch; town/arena tuned separately. Use M debug for spawns.
    // "submeshMaterials" maps tinyobj MTL names to scene lit materials.
    // Desert_Town ground.001 uses tilted normals (~34° from +Y in +Z) — pitch corrects it to horizontal XZ.

    "start-scene": "play",
    "window": {
        "title": "Aladdin — Level 3 (Town -> Fort -> Arena)",
        "size": { "width": 1280, "height": 720 },
        "fullscreen": false
    },
    "game": {
        "total_coins": 10,
        "total_enemies": 14,
        "time_3star": 300,
        "time_2star": 420,
        "time_1star": 600,
        "game_over_fall_y": -55
    },

    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": { "vs": "assets/shaders/tinted.vert", "fs": "assets/shaders/tinted.frag" },
